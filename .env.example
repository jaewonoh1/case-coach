# Case Coach environment variables.
# Copy this file to `.env` (in this folder, or one level up) and fill in your key.
# NEVER commit your real .env or your PORTKEY_API_KEY.

# Required: your Yale course Portkey key. The app checks .env here first, then one
# level above this folder (per the course rules).
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides (defaults shown):
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CASE_COACH_MODEL=gpt-6-luna
# CASE_COACH_REASONING_EFFORT=none
# CASE_COACH_MAX_TURNS=40
# CASE_COACH_TOKEN_BUDGET=300000

# Tokenomics: gpt-6-luna prices (USD per 1M tokens). The app already defaults to
# the course rates below (MGT 409 lecture 11); only set these to override.
# PRICE_INPUT_PER_M=0.10
# PRICE_CACHED_PER_M=0.01
# PRICE_OUTPUT_PER_M=0.50
